{
  "mcpServers": {
    "ato": {
      "type": "stdio",
      "command": "/srv/ato/venv/bin/ato",
      "args": ["mcp", "--stdio", "--config", "/srv/ato/server-stdio.json"],
      "env": {
        "ATO_HOME": "/srv/ato/state",
        "CODEX_HOME": "/srv/ato/codex",
        "ATO_SERVER_TOKEN_BOT": "${env:ATO_SERVER_TOKEN_BOT}"
      }
    }
  }
}
