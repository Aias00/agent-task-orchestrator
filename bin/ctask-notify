#!/bin/sh
set -eu
case "${1-}" in
  control|notification-policy|followups|presented) ;;
  *) echo 'Usage: ctask-notify {control|notification-policy|followups|presented} ...' >&2; exit 2 ;;
esac
ctask_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "${CTASK_PYTHON:-python3.12}" "$ctask_root/runner.py" "$@"
